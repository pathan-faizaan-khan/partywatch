# PartyWatch Frontend Environment Configuration
# Copy this to .env.local for local development, or configure in your deployment platform (Vercel, Netlify, etc.)

# Backend API URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend WebSocket URL (ws:// for local, wss:// for production HTTPS)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
